# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── n8n Payment Workflow ──────────────────────────────────────────────────────

# N8N_WEBHOOK_URL: The webhook URL from your n8n workflow.
# After importing payai-n8n-workflow.json into n8n Cloud, copy the
# webhook URL from the "Invoice Webhook Trigger" node and paste it here.
# Example: https://your-instance.app.n8n.cloud/webhook/payai-invoice
N8N_WEBHOOK_URL="YOUR_N8N_WEBHOOK_URL"

# N8N_SECRET: Shared secret between your server and n8n for request validation.
# Must match the value in the "Validate Invoice & Policy" Code node in n8n.
# Change this to any strong random string in production.
N8N_SECRET="payai-secret-2026"

# VITE_N8N_WEBHOOK_URL: URL the frontend (WalletContext.tsx) calls to trigger payments.
# In development this points to your local server bridge at /api/n8n/trigger.
# In production replace with your deployed server URL.
VITE_N8N_WEBHOOK_URL="http://localhost:3000/api/n8n/trigger"

# PAYAI_BACKEND_URL: Your server's base URL, used by n8n to call back into
# your server for payment execution via /api/v1/pay.
# In development use your ngrok URL so n8n Cloud can reach your local server.
# Example: https://abc123.ngrok.io
PAYAI_BACKEND_URL="http://localhost:3000"
